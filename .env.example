# ============================================================================
# DECISIONVERSE AI - LOCAL ENVIRONMENT TEMPLATE
# ============================================================================
#
# Copy this file to '.env' at the root of the workspace to configure local execution.
#
# ============================================================================

# Drizzle Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisionverse

# Gemini API Key (Required for AI Courtroom agents)
GEMINI_API_KEY=your_api_key_here
# Backend Server PORT (default 5000)
PORT=5000

# Base routing path for application
BASE_PATH=/

# Authentication options for local development (set 'true' to enforce authorization checks)
REQUIRE_AUTH=false

# Allowed Frontend Origin URL (for CORS validation filtering)
FRONTEND_URL=http://localhost:5173

# Partner MCP Server Integration Configuration (Optional)
# Set MCP_SERVER_TYPE to 'stdio' or 'sse' to connect to a partner server. Leave empty to disable.
MCP_SERVER_TYPE=
MCP_SERVER_URL=http://localhost:3000/sse
MCP_SERVER_CMD=node
MCP_SERVER_ARGS=path/to/partner-mcp-server/index.js
